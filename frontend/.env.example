# Base URL for frontend API requests (defaults to /api to use Vite dev proxy)
VITE_API_BASE_URL=/api

# Proxy target for Vite dev server to forward /api requests.
# For local backend: http://localhost:5237
# For teammates using shared backend via ngrok: https://<your-ngrok-subdomain>.ngrok-free.dev
VITE_API_PROXY_TARGET=https://drab-smoking-unstaffed.ngrok-free.dev